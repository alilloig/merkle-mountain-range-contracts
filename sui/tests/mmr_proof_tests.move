// ------------------------------------------------------------------------------ helpers

/// True with the leaf's own data, false with the next leaf's data; the batch of one equals the
/// single proof (`siblings == path`, `untouched == left ++ right`) and verifies.
fun check_single(ns: &NodeSet, leaf_no: u64) {
    let position = mmr_prover::leaf_position(leaf_no);
    let (path, left, right) = ns.single_proof(position);
    let root = ns.root();
    let size = ns.size();
    assert!(mmr_proof::verify_with_root(root, size, position, mmr_prover::leaf_data(leaf_no), path, left, right));
    assert!(!mmr_proof::verify_with_root(root, size, position, mmr_prover::leaf_data(leaf_no + 1), path, left, right));
    let (siblings, untouched) = ns.batch_proof(vector[position]);
    assert_eq!(siblings, path);
    let mut expected_untouched = left;
    expected_untouched.append(right);
    assert_eq!(untouched, expected_untouched);
    assert!(mmr_proof::verify_multiple_with_root(root, size, vector[position], vector[mmr_prover::leaf_data(leaf_no)], siblings, untouched));
}

/// The batch proof of `leaf_numbers` verifies; one wrong leaf makes it false.
fun check_batch(ns: &NodeSet, leaf_numbers: vector<u64>) {
    let positions = leaf_numbers.map_ref!(|n| mmr_prover::leaf_position(*n));
    let leaves = leaf_numbers.map_ref!(|n| mmr_prover::leaf_data(*n));
    let (siblings, untouched) = ns.batch_proof(positions);
    assert!(mmr_proof::verify_multiple_with_root(ns.root(), ns.size(), positions, leaves, siblings, untouched));
    let mut bad = leaves;
    *(&mut bad[0]) = b"not the leaf";
    assert!(!mmr_proof::verify_multiple_with_root(ns.root(), ns.size(), positions, bad, siblings, untouched));
}

/// Independent count of the proof hashes a batch needs: the frontier of the union of the leaf
/// paths (siblings of ancestors that are neither batch leaves nor ancestors) plus the peaks of
/// the mountains no batch leaf touches. Port of `naive_multiproof_hash_count` (mmr_ref.py).
fun frontier_hash_count(size: u64, positions: &vector<u64>): u64 {
    let peaks = mmr_utils::get_peaks_positions(size);
    // membership bitmaps over positions 0..size (index 0 unused)
    let mut is_peak = vector::tabulate!(size + 1, |_| false);
    peaks.do_ref!(|p| *(&mut is_peak[*p]) = true);
    // ancestors of the batch leaves, the leaves themselves included
    let mut anc = vector[];
    let mut in_anc = vector::tabulate!(size + 1, |_| false);
    positions.do_ref!(|p| {
        let mut cur = *p;
        while (!is_peak[cur]) {
            if (!in_anc[cur]) { anc.push_back(cur); *(&mut in_anc[cur]) = true; };
            cur = mmr_utils::get_parent_position(cur);
        };
        if (!in_anc[cur]) { anc.push_back(cur); *(&mut in_anc[cur]) = true; };
    });
    // siblings of ancestors that are neither leaves nor ancestors must come from the proof
    let mut needed = 0;
    let mut in_needed = vector::tabulate!(size + 1, |_| false);
    anc.do_ref!(|a| {
        if (!is_peak[*a]) {
            let s = mmr_utils::get_sibling_position(*a);
            if (!in_anc[s] && !in_needed[s]) { needed = needed + 1; *(&mut in_needed[s]) = true; };
        };
    });
    let mut untouched = 0;
    peaks.do_ref!(|p| if (!in_anc[*p]) untouched = untouched + 1);
    needed + untouched
}

/// Copy of `hashes` with the first byte of entry `i` flipped.
fun flip(hashes: vector<vector<u8>>, i: u64): vector<vector<u8>> {
    let mut v = hashes;
    let byte = &mut v[i][0];
    *byte = *byte ^ 0x01;
    v
}

/// Copy of `hashes` with entries 0 and 1 swapped.
fun swap01(hashes: vector<vector<u8>>): vector<vector<u8>> {
    let mut v = hashes;
    v.swap(0, 1);
    v
}

/// Deterministic pseudo-random u64 (LCG in u128 arithmetic).
fun next(state: &mut u128): u64 {
    *state = ((*state * 6364136223846793005) + 1442695040888963407) % (1u128 << 64);
    (*state >> 33) as u64
}

