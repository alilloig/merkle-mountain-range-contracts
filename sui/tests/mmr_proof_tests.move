#[test]
fun readme_proof_for_position_16() {
    let ns = mmr_prover::build(13);
    let (path, left, right) = ns.single_proof(16);
    assert_eq!(path, vector[N17, N21]);
    assert_eq!(left, vector[N15]);
    assert_eq!(right, vector[N23]);
    assert!(mmr_proof::verify_with_root(ROOT_13, 23, 16, b"9", path, left, right));
    assert!(!mmr_proof::verify_with_root(ROOT_13, 23, 16, b"8", path, left, right));
}

#[test]
fun worked_batch_examples() {
    let ns = mmr_prover::build(13);
    // {1}
    let (s, u) = ns.batch_proof(vector[1]);
    assert_eq!(s, vector[N2, N6, N14]);
    assert_eq!(u, vector[N22, N23]);
    assert!(mmr_proof::verify_multiple_with_root(ROOT_13, 23, vector[1], vector[b"1"], s, u));
    // {16} == the README single proof: path [n17, n21], left [n15], right [n23]
    let (s, u) = ns.batch_proof(vector[16]);
    assert_eq!(s, vector[N17, N21]);
    assert_eq!(u, vector[N15, N23]);
    assert!(mmr_proof::verify_multiple_with_root(ROOT_13, 23, vector[16], vector[b"9"], s, u));
    // {1, 2}: the sibling leaf is derived, nothing is read for it
    let (s, u) = ns.batch_proof(vector[1, 2]);
    assert_eq!(s, vector[N6, N14]);
    assert_eq!(u, vector[N22, N23]);
    assert!(mmr_proof::verify_multiple_with_root(ROOT_13, 23, vector[1, 2], vector[b"1", b"2"], s, u));
    // {4, 9, 16}: siblings in (height, position) order per mountain (n3 after n8)
    let (siblings, untouched) = ns.batch_proof(vector[4, 9, 16]);
    assert_eq!(siblings, vector[N5, N8, N3, N13, N17, N21]);
    assert_eq!(untouched, vector[N23]);
    let leaves = vector[b"3", b"6", b"9"];
    assert!(mmr_proof::verify_multiple_with_root(ROOT_13, 23, vector[4, 9, 16], leaves, siblings, untouched));
    // position-sorted sibling order is wrong
    let wrong_order = vector[N3, N5, N8, N13, N17, N21];
    assert!(!mmr_proof::verify_multiple_with_root(ROOT_13, 23, vector[4, 9, 16], leaves, wrong_order, untouched));
    // {23}: a leaf that is a peak
    let (s, u) = ns.batch_proof(vector[23]);
    assert_eq!(s, vector[]);
    assert_eq!(u, vector[N15, N22]);
    assert!(mmr_proof::verify_multiple_with_root(ROOT_13, 23, vector[23], vector[b"13"], s, u));
    // all leaves: no proof hashes at all
    let (s, u) = ns.batch_proof(ALL_13);
    assert_eq!(s, vector[]);
    assert_eq!(u, vector[]);
    assert!(mmr_proof::verify_multiple_with_root(ROOT_13, 23, ALL_13, mmr_prover::leaves(13), s, u));
}

#[test]
fun compute_root_matches_verify() {
    let ns = mmr_prover::build(13);
    let (path, left, right) = ns.single_proof(16);
    assert_eq!(mmr_proof::compute_root(23, 16, b"9", path, left, right), ROOT_13);
    assert!(mmr_proof::compute_root(23, 16, b"8", path, left, right) != ROOT_13);
    let (siblings, untouched) = ns.batch_proof(vector[4, 9, 16]);
    let leaves = vector[b"3", b"6", b"9"];
    assert_eq!(mmr_proof::compute_batch_root(23, vector[4, 9, 16], leaves, siblings, untouched), ROOT_13);
}

/// A proof of one MMR never verifies against the root of another MMR of the same shape, and
/// the other MMR's honest proof verifies only against its own root.
#[test]
fun proofs_are_bound_to_their_anchor() {
    let ns13 = mmr_prover::build(13);
    let (path, left, right) = ns13.single_proof(16);
    // another 13-leaf MMR with different data ("1!".."13!"): same shape, different root
    let mut other = mmr_prover::new();
    other.append_all(vector::tabulate!(13, |i| { let mut d = mmr_prover::leaf_data(i + 1); d.push_back(33); d }));
    assert_eq!(other.size(), 23);
    assert!(other.root() != ROOT_13);
    assert!(!mmr_proof::verify_with_root(other.root(), 23, 16, b"9", path, left, right));
    let (path2, left2, right2) = other.single_proof(16);
    assert!(mmr_proof::verify_with_root(other.root(), 23, 16, b"9!", path2, left2, right2));
    assert!(!mmr_proof::verify_with_root(ROOT_13, 23, 16, b"9!", path2, left2, right2));
    assert!(!mmr_proof::verify_with_root(ROOT_13, 23, 16, b"9", path2, left2, right2));
}

