/// Batch checks for strictly increasing leaf `positions` of the "1".."n" fixture: the proof
/// verifies, its size equals the independent frontier count, `compute_batch_root` agrees, and a
/// wrong leaf at `wrong_index` makes it false.
fun check_batch_positions(ns: &NodeSet, positions: vector<u64>, wrong_index: u64) {
    let root = ns.root();
    let size = ns.size();
    let leaves = positions.map_ref!(|p| mmr_prover::leaf_data(mmr_utils::position_to_leaf_index(*p) + 1));
    let (siblings, untouched) = ns.batch_proof(positions);
    assert_eq!(siblings.length() + untouched.length(), frontier_hash_count(size, &positions));
    assert!(mmr_proof::verify_multiple_with_root(root, size, positions, leaves, siblings, untouched));
    assert_eq!(mmr_proof::compute_batch_root(size, positions, leaves, siblings, untouched), root);
    let mut wrong = leaves;
    *(&mut wrong[wrong_index]) = b"x";
    assert!(!mmr_proof::verify_multiple_with_root(root, size, positions, wrong, siblings, untouched));
}

/// Batches that touch every mountain shape of the README MMR: a whole mountain, one leaf per
/// mountain, the two peak neighbours, and adjacent pairs across mountain borders.
#[test]
fun structured_batches_13() {
    let ns = mmr_prover::build(13);
    check_batch_positions(&ns, vector[1, 2, 4, 5, 8, 9, 11, 12], 3);
    check_batch_positions(&ns, vector[16, 17, 19, 20], 0);
    check_batch_positions(&ns, vector[1, 16, 23], 1);
    check_batch_positions(&ns, vector[12, 16], 0);
    check_batch_positions(&ns, vector[20, 23], 1);
    check_batch_positions(&ns, vector[1, 23], 0);
    check_batch_positions(&ns, vector[2, 5, 9, 12, 17, 20], 5);
    check_batch_positions(&ns, vector[1, 4, 8, 11, 16, 19, 23], 6);
}

// ------------------------------------------------------------------------------ tamper (false)

#[test]
fun tampered_single_proofs_are_false() {
    let ns = mmr_prover::build(13);
    let root = ns.root();
    13u64.do!(|i| {
        let position = mmr_prover::leaf_position(i + 1);
        let data = mmr_prover::leaf_data(i + 1);
        let (path, left, right) = ns.single_proof(position);
        path.length().do!(|j| assert!(!mmr_proof::verify_with_root(root, 23, position, data, flip(path, j), left, right)));
        left.length().do!(|j| assert!(!mmr_proof::verify_with_root(root, 23, position, data, path, flip(left, j), right)));
        right.length().do!(|j| assert!(!mmr_proof::verify_with_root(root, 23, position, data, path, left, flip(right, j))));
        assert!(!mmr_proof::verify_with_root(flip(vector[root], 0)[0], 23, position, data, path, left, right));
        if (path.length() >= 2) {
            assert!(!mmr_proof::verify_with_root(root, 23, position, data, swap01(path), left, right));
        };
        // the same proof moved to the sibling leaf position (same shape, wrong position);
        // a leaf that is a peak (empty path) has no sibling
        if (path.length() > 0) {
            let sibling = mmr_utils::get_sibling_position(position);
            assert!(!mmr_proof::verify_with_root(root, 23, sibling, data, path, left, right));
        };
    });
}

#[test]
fun tampered_batch_proofs_are_false() {
    let ns = mmr_prover::build(13);
    let positions = vector[4, 9, 16];
    let leaves = vector[b"3", b"6", b"9"];
    let (siblings, untouched) = ns.batch_proof(positions);
    siblings.length().do!(|j| assert!(!mmr_proof::verify_multiple_with_root(ROOT_13, 23, positions, leaves, flip(siblings, j), untouched)));
    assert!(!mmr_proof::verify_multiple_with_root(ROOT_13, 23, positions, leaves, siblings, flip(untouched, 0)));
    // proof moved to a different (valid) leaf set with the same hashes -> false
    assert!(!mmr_proof::verify_multiple_with_root(ROOT_13, 23, vector[5, 9, 16], leaves, siblings, untouched));
}

