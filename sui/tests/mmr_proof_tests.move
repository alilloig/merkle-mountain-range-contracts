fun golden_roots() {
    assert_eq!(mmr_prover::build(0).root(), ROOT_0);
    assert_eq!(mmr_prover::build(1).root(), ROOT_1);
    assert_eq!(mmr_prover::build(2).root(), ROOT_2);
