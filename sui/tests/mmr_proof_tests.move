/// `count` pseudo-random subsets (about one leaf in seven) of an n-leaf MMR, after skipping the
/// first `skip` subsets of the same LCG stream. Every proof size equals the independent frontier
/// count.
fun check_random_subsets(n: u64, seed: u128, skip: u64, count: u64) {
    let ns = mmr_prover::build(n);
    let mut state = seed;
    skip.do!(|_| n.do!(|_| { next(&mut state); }));
    count.do!(|_| {
        let mut leaf_numbers = vector[];
        n.do!(|i| if (next(&mut state) % 7 == 0) leaf_numbers.push_back(i + 1));
        if (leaf_numbers.is_empty()) leaf_numbers.push_back(1);
        let positions = leaf_numbers.map_ref!(|l| mmr_prover::leaf_position(*l));
        let leaves = leaf_numbers.map_ref!(|l| mmr_prover::leaf_data(*l));
        let (siblings, untouched) = ns.batch_proof(positions);
        assert!(mmr_proof::verify_multiple_with_root(ns.root(), ns.size(), positions, leaves, siblings, untouched));
        let mut bad = leaves;
        *(&mut bad[0]) = b"not the leaf";
        assert!(!mmr_proof::verify_multiple_with_root(ns.root(), ns.size(), positions, bad, siblings, untouched));
        assert_eq!(siblings.length() + untouched.length(), frontier_hash_count(ns.size(), &positions));
    });
}

