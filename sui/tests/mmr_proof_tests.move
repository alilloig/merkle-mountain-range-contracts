// ------------------------------------------------------------------------------ exhaustive subsets

/// Every subset of the leaves of an n-leaf MMR whose bitmask lies in [from_mask, to_mask].
fun check_subsets(n: u64, from_mask: u64, to_mask: u64) {
    let ns = mmr_prover::build(n);
    let mut mask = from_mask;
    while (mask <= to_mask) {
        let mut leaf_numbers = vector[];
        n.do!(|i| if ((mask >> (i as u8)) & 1 == 1) leaf_numbers.push_back(i + 1));
        check_batch(&ns, leaf_numbers);
        mask = mask + 1;
    };
}

